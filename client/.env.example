# Messbee Frontend - Environment Variables

# API Base URL (use local for development)
VITE_API_URL=http://localhost:5002/api

# Production URL (uncomment for production):
# VITE_API_URL=https://webservices.messbee.com/api/

# App Configuration
VITE_APP_NAME=Messbee
VITE_APP_VERSION=1.0.0

# For production, change to your deployed backend URL:
# VITE_API_URL=https://api.messbee.com/api

# Meta App Configuration for WhatsApp Embedded Signup & Facebook Login
VITE_FB_LOGIN_APP_ID=921773847630961
VITE_META_APP_ID=1401700501230008
VITE_META_CONFIG_ID=3478777475636588

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here