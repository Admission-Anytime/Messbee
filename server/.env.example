# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/messbee

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRE=7d

# CORS
CLIENT_URL=http://localhost:5173


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Messbee
FROM_EMAIL=noreply@messbee.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Socket.IO
SOCKET_PORT=5001

# WhatsApp Business API Configuration
# Get these from Meta Business Manager (https://business.facebook.com/)
# 1. Go to Meta Business Manager > WhatsApp > API Setup
# 2. Copy your Phone Number ID, Access Token, and Business Account ID
# 3. Set up webhook URL: https://yourdomain.com/api/whatsapp/webhook

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v18.0

# Webhook Configuration
# This token is used to verify webhook requests from WhatsApp
# You can set this to any secure random string (e.g., use: openssl rand -hex 32)
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here

# Optional: For webhook signature verification (recommended for production)
WHATSAPP_APP_SECRET=your_app_secret_here
