{
  "info": {
    "name": "Messbee Backend - Postman Collection",
    "_postman_id": "messbee-backend-collection",
    "description": "Collection for testing Messbee backend endpoints (auth + status). Use environment variables: baseUrl, authToken, statusId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\",\n  \"company\": \"Acme\"\n}"
            },
            "description": "Register a new user."
          },
          "response": []
        },
        {
          "name": "Login - POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login and obtain JWT token. The collection test will store token to environment variable `authToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save token to environment variable 'authToken' if present",
                  "try {",
                  "  var json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.environment.set('authToken', json.token);",
                  "    console.log('authToken saved');",
                  "  } else if (json.data && json.data.token) {",
                  "    pm.environment.set('authToken', json.data.token);",
                  "    console.log('authToken saved (data.token)');",
                  "  }",
                  "} catch (e) { console.log('No JSON token'); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Me - GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Get current logged-in user. Requires Authorization header."
          },
          "response": []
        },
        {
          "name": "Update Details - PUT /api/auth/updatedetails",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/updatedetails",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            },
            "description": "Update user details."
          },
          "response": []
        },
        {
          "name": "Update Password - PUT /api/auth/updatepassword",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/updatepassword",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newPassword123\"\n}"
            },
            "description": "Change current user's password."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Status",
      "item": [
        {
          "name": "Get Statuses - GET /api/status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/status",
            "description": "Retrieve all statuses for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Create Status - POST /api/status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Status\",\n  \"description\": \"A short description\",\n  \"color\": \"#00FF00\",\n  \"createdBy\": \"Admin\"\n}"
            },
            "description": "Create a new status. Controller enforces a 5-status limit per user."
          },
          "response": []
        },
        {
          "name": "Update Status - PUT /api/status/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/status/{{statusId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Status\",\n  \"description\": \"Updated description\",\n  \"color\": \"#FF0000\"\n}"
            },
            "description": "Update an existing status. Set `statusId` environment variable to the status `_id`."
          },
          "response": []
        },
        {
          "name": "Delete Status - DELETE /api/status/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/api/status/{{statusId}}",
            "description": "Delete a status by id. Set `statusId` environment variable."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "authToken", "value": "" },
    { "key": "statusId", "value": "" }
  ]
}
